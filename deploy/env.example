# Copy to .env next to docker-compose.yml on the host. Never commit real values.

# --- Database (qavren-db, schema `recharacter`) ---
# Runtime connection — MUST be the :6543 transaction-pooler URL, role `recharacter`.
DATABASE_URL=
# Deploy-time migrations only — set as the Actions secret consumed by the
# `migrate` job in .github/workflows/deploy.yml (session :5432 pooler URL).
# Not needed in this file; documented here for completeness.
# DATABASE_URL_MIGRATE=

# --- Auth (Auth.js + Keycloak/qavren-auth) ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://recharacter.us
QAVREN_AUTH_URL=https://auth.recharacter.us
QAVREN_REALM=recharacter
QAVREN_ADMIN_CLIENT_ID=recharacter-admin-svc
# Used for account deletion — same value as the auth box's RECHARACTER_ADMIN_CLIENT_SECRET;
# rotate together. Without it, deletion fails closed.
QAVREN_ADMIN_CLIENT_SECRET=
# Optional override; defaults to QAVREN_AUTH_URL.
KEYCLOAK_ADMIN_BASE_URL=
# Public origin (Stripe redirects when payments are wired).
APP_BASE_URL=https://recharacter.us

# --- Object storage (Cloudflare R2 / S3 API) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=recharacter-case-documents
# Leave unset in prod — only overrides the endpoint for dev/CI MinIO.
# S3_ENDPOINT=

# --- AI ---
# Managed-tier AI (server only)
ANTHROPIC_API_KEY=

# Production KEK for BYOK key encryption: openssl rand -base64 32
# Losing this makes stored BYOK keys undecryptable (users just re-enter them).
AI_KEY_ENCRYPTION_SECRET=

# AI cost guardrails (optional; defaults shown). Per-user AI requests per minute
# (all tasks, BYOK included), managed-tier (non-BYOK) input+output tokens per
# user per UTC day, and the shared managed-tier daily ceiling across all users.
# BYOK calls are exempt from both token caps.
# AI_RATE_LIMIT_PER_MINUTE=10
# AI_MANAGED_DAILY_TOKEN_CAP=2000000
# AI_GLOBAL_DAILY_TOKEN_CAP=20000000

# --- Billing (Stripe) ---
# Leave unset at launch: upgrade page degrades gracefully; BYOK unlocks.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# --- Infra ---
# Cloudflare Zero Trust -> Tunnels -> your tunnel -> token
TUNNEL_TOKEN=

# ROUTING_API_URL is NOT set here: deploy/docker-compose.yml injects
# http://routing:8080 for the web service.
