# --- Database (qavren-db, schema `recharacter`) ---
# Runtime connection — transaction pooler. Local dev: compose.dev.yaml Postgres on 55433.
DATABASE_URL=postgres://recharacter:recharacter@127.0.0.1:55433/recharacter
# Deploy-time migrations only (session pooler). Falls back to DATABASE_URL when unset.
DATABASE_URL_MIGRATE=

# --- Auth (Auth.js + Keycloak/qavren-auth) ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Local dev signs in against the live realm; http://localhost:3000/* is an allowed redirect.
QAVREN_AUTH_URL=https://auth.recharacter.us
QAVREN_REALM=recharacter
QAVREN_ADMIN_CLIENT_ID=recharacter-admin-svc
# Used for account deletion — same value the auth box holds as RECHARACTER_ADMIN_CLIENT_SECRET;
# rotate together. Without it, deletion fails closed.
QAVREN_ADMIN_CLIENT_SECRET=
# Optional override; defaults to QAVREN_AUTH_URL.
KEYCLOAK_ADMIN_BASE_URL=
# Used to build redirect URLs (Stripe, etc.).
APP_BASE_URL=http://localhost:3000

# --- Object storage (Cloudflare R2 / S3 API) ---
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=minio12345
R2_BUCKET=recharacter-case-documents
# Dev/CI MinIO override only — unset in prod so the R2 endpoint is used.
S3_ENDPOINT=http://127.0.0.1:9100

# --- AI ---
# Managed-tier Anthropic key (server only) — used when a user has no BYOK credential.
ANTHROPIC_API_KEY=
# Base64, 32 bytes — KEK for encrypting BYOK keys at rest (server only).
AI_KEY_ENCRYPTION_SECRET=
# AI cost guardrails (server only; defaults shown) — per-user AI requests per
# minute (all tasks), managed-tier (non-BYOK) tokens per user per UTC day, and
# the shared managed-tier daily ceiling across all users.
AI_RATE_LIMIT_PER_MINUTE=10
AI_MANAGED_DAILY_TOKEN_CAP=2000000
AI_GLOBAL_DAILY_TOKEN_CAP=20000000

# --- Billing (Stripe) ---
# Leave unset in dev/test: the upgrade page shows a "payments not yet configured"
# notice and BYOK remains the working entitlement path; no live key is needed for any test.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# --- Infra ---
# .NET routing service (dotnet run --project src/ReCharacter.RoutingApi)
ROUTING_API_URL=
