// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`evidence page > case details saved: the checklist with saved statuses 1`] = `"<main><h1>Your evidence checklist</h1><p><strong>9/100</strong> — building</p><p>Your highest-value next step: Buddy / witness statements. Statements from people who saw what happened or saw how you changed. Especially important when the events were unreported or disbelieved at the time.</p><ul><li><p><strong>Nexus letter from a mental-health clinician</strong></p><p>A letter from a mental-health professional connecting your in-service condition to the conduct behind your discharge. The single most persuasive document a petition can include.</p><form action="[server action]"><input type="hidden" name="itemType" value="nexus_letter"/><label>Status<select name="status"><option value="needed">Needed</option><option value="requested">Requested</option><option value="collected">Collected</option><option value="not_applicable" selected="">Not applicable</option></select></label><button type="submit">Save</button></form></li><li><p><strong>Buddy / witness statements</strong></p><p>Statements from people who saw what happened or saw how you changed. Especially important when the events were unreported or disbelieved at the time.</p><form action="[server action]"><input type="hidden" name="itemType" value="buddy_statement"/><label>Status<select name="status"><option value="needed">Needed</option><option value="requested" selected="">Requested</option><option value="collected">Collected</option><option value="not_applicable">Not applicable</option></select></label><button type="submit">Save</button></form></li><li><p><strong>Service treatment / in-service mental-health records</strong></p><p>Records from your time in service showing the condition or the events around it.</p><form action="[server action]"><input type="hidden" name="itemType" value="service_treatment_records"/><label>Status<select name="status"><option value="needed" selected="">Needed</option><option value="requested">Requested</option><option value="collected">Collected</option><option value="not_applicable">Not applicable</option></select></label><button type="submit">Save</button></form></li><li><p><strong>Your personal statement</strong></p><p>Your own account, structured around the four questions the board must weigh. Drafted later in this app. For MST-related petitions, review boards are directed to accept your own statement as evidence that the experience occurred — the absence of a contemporaneous report does not sink a case.</p><form action="[server action]"><input type="hidden" name="itemType" value="personal_statement"/><label>Status<select name="status"><option value="needed" selected="">Needed</option><option value="requested">Requested</option><option value="collected">Collected</option><option value="not_applicable">Not applicable</option></select></label><button type="submit">Save</button></form></li><li><p><strong>Civilian mental-health records</strong></p><p>Diagnosis or treatment records from before or after service — they show the trajectory.</p><form action="[server action]"><input type="hidden" name="itemType" value="civilian_mh_records"/><label>Status<select name="status"><option value="needed" selected="">Needed</option><option value="requested">Requested</option><option value="collected">Collected</option><option value="not_applicable">Not applicable</option></select></label><button type="submit">Save</button></form></li><li><p><strong>DD-214 (Certificate of Release or Discharge)</strong></p><p>The baseline document for any petition. You likely already uploaded it during intake.</p><form action="[server action]"><input type="hidden" name="itemType" value="dd214"/><label>Status<select name="status"><option value="needed">Needed</option><option value="requested">Requested</option><option value="collected" selected="">Collected</option><option value="not_applicable">Not applicable</option></select></label><button type="submit">Save</button></form></li></ul><p>Why these items? This checklist and score measure completeness of your evidence — they do not predict any board&#x27;s decision.</p><div data-coaching=""></div><p><a href="/case">Back to case</a></p></main>"`;

exports[`evidence page > no case details yet: the condition form 1`] = `"<main><h1>Tell us about your case</h1><p role="alert">Check the form.</p><p>Four quick questions personalize the evidence checklist below.</p><form action="[server action]"><label>Condition category<select name="conditionCategory" required=""><option value="" disabled="" selected="">Select…</option><option value="ptsd">PTSD</option><option value="tbi">Traumatic brain injury (TBI)</option><option value="depression_anxiety">Depression or anxiety</option><option value="adjustment_disorder">Adjustment disorder</option><option value="other_mh">Other mental-health condition</option><option value="unsure">Not sure</option></select></label><label><input type="checkbox" name="mstInvolved"/>My case involves military sexual trauma (MST)</label><label><input type="checkbox" name="treatedInService"/>I was treated for this condition while in service</label><label><input type="checkbox" name="hasVaRating"/>I have a VA disability rating for this condition</label><button type="submit">Continue</button></form><p><a href="/case">Back to case</a></p></main>"`;
